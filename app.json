{
  "expo": {
    "name": "OneHR",
    "slug": "one-hr-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/generated/app-icon.png",
    "splash": {
      "image": "./src/assets/generated/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./src/assets/generated/app-icon.png",
      "bundleIdentifier": "com.kiranloka.onehrmobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/generated/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.kiranloka.onehrmobile"
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show current location on map."
        }
      ]
    ]
  }
}
